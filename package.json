{
  "name": "platinum-path",
  "version": "1.1.0",
  "description": "Local game library with Steam sync (playtime & achievements) and estimated completion difficulty",
  "author": "MuerteMil",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:linux:deb": "electron-builder --linux deb"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.muertemil.platinumpath",
    "productName": "Platinum Path",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    }
  }
}

